# WebScout — пример файла переменных окружения
#
# Скопируйте в .env и заполните нужные значения.
# Большинство параметров задаются в config.yaml — здесь только то,
# что логично держать вне репозитория (секреты, окружение-специфичные настройки).
#
# Примечание: на данный момент код читает конфигурацию из config.yaml.
# Переменные ниже будут подхватываться по мере добавления поддержки os.getenv().

# --- Прокси -------------------------------------------------------------------

# URL прокси-сервера (соответствует proxy.url в config.yaml).
# Форматы: http://host:port, http://user:pass@host:port, socks5://host:port
WEBSCOUT_PROXY_URL=

# --- Браузер ------------------------------------------------------------------

# Запускать Chromium в видимом окне (false) или фоново (true).
# Удобно переключать при отладке без правки config.yaml.
# Соответствует browser.headless в config.yaml.
WEBSCOUT_HEADLESS=true

# --- Конфигурация -------------------------------------------------------------

# Путь к альтернативному config.yaml (по умолчанию — config.yaml в корне).
WEBSCOUT_CONFIG=

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
WEBSCOUT_LOG_LEVEL=INFO

# --- API-ключи (запланировано) ------------------------------------------------

# SuperJob — REST API для поиска вакансий.
# Требует регистрации на api.superjob.ru. Источник отложен до будущей фазы.
SUPERJOB_API_KEY=your_superjob_api_key_here
